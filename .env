DATABASE_URL=file:../db/custom.db

# ── dev_gstack merge (Features #1-#5) ──
# HMAC secret for the dev-fallback session cookie (src/lib/session.ts).
# Insecure default is used when unset, so this is REQUIRED in production.
AUTH_DEV_SECRET=nest-demo-dev-fallback-session-secret-2026

# Comma-separated allowlist: these emails are promoted to role=ADMIN on first
# authenticated request (bootstraps the first admin without DB surgery).
ADMIN_EMAILS=admin@nestnulo.com

